@page "/"

<HeadContent>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="TarkovCalculator.styles.css" />
</HeadContent>

<h3 class="page-title">Best Resells In Tarkov</h3>

@if (isLoading)
{
    <p class="loading-text" style="color: #d4d4d4; text-align: center;">Loading Items...</p>
}
else
{
    int position = 1;

    <div class="items-container">
        @foreach (var item in items)
        {
            <div class="item-card">
                <div class="item-rank">@position</div>
                <div class="item-content">
                    <div class="item-image">
                        <img src="@item.Image" alt="@item.Name" />
                    </div>
                    <div class="item-details">
                        <h2 class="item-profit">₽@item.Profit</h2>
                        <p class="item-name">@item.Name</p>
                        <p class="item-price">Flea Price: @item.FleaLowPrice</p>
                        <p class="item-trader">@GetTraderName(item.BestTraderName) - @item.BestTraderPrice</p>
                    </div>
                </div>
            </div>

            position++;
        }
    </div>
}